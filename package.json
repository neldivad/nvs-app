{
  "name": "novel-visual-studio",
  "version": "0.2.0",
  "description": "A desktop authoring environment for dialogue-driven fiction — a writing IDE with a built-in narrative-analysis engine.",
  "author": "neldivad",
  "license": "AGPL-3.0-only",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc -b && electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "ingest:headless": "esbuild scripts/ingestHeadless.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --alias:@shared=./src/shared --outfile=out/headless/ingest.cjs && ELECTRON_RUN_AS_NODE=1 electron out/headless/ingest.cjs",
    "analysis:headless": "esbuild scripts/analysisHeadless.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --external:electron --external:@anthropic-ai/claude-agent-sdk --external:@anthropic-ai/sdk --alias:@shared=./src/shared --alias:@engine=./src/engine --alias:@main=./src/main --outfile=out/headless/analysis.cjs && ELECTRON_RUN_AS_NODE=1 electron out/headless/analysis.cjs",
    "mcp:build": "esbuild scripts/nvsMcp.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --external:electron --external:@anthropic-ai/claude-agent-sdk --external:@anthropic-ai/sdk --alias:@shared=./src/shared --alias:@engine=./src/engine --alias:@main=./src/main --outfile=out/headless/mcp.cjs",
    "mcp:headless": "npm run mcp:build && ELECTRON_RUN_AS_NODE=1 electron out/headless/mcp.cjs",
    "analysis:telemetry": "node scripts/telemetryReport.mjs",
    "probe:storysofar": "esbuild scripts/probeStorySoFar.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --external:electron --alias:@shared=./src/shared --alias:@engine=./src/engine --alias:@main=./src/main --outfile=out/headless/probe.cjs && ELECTRON_RUN_AS_NODE=1 electron out/headless/probe.cjs",
    "verify:graph": "esbuild scripts/verifyGraphAxis.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --alias:@shared=./src/shared --alias:@engine=./src/engine --outfile=out/headless/verify.cjs && ELECTRON_RUN_AS_NODE=1 electron out/headless/verify.cjs",
    "render:check": "esbuild scripts/renderCheck.ts --bundle --platform=node --format=cjs --external:gray-matter --log-level=silent --outfile=out/headless/render.cjs && node out/headless/render.cjs",
    "eval:tools": "esbuild scripts/evalToolCalling.ts --bundle --platform=node --format=cjs --alias:@shared=./src/shared --log-level=silent --outfile=out/headless/eval.cjs && node out/headless/eval.cjs",
    "i18n:translate": "esbuild scripts/i18nTranslate.ts --bundle --platform=node --format=cjs --log-level=silent --outfile=out/headless/i18nTranslate.cjs && node out/headless/i18nTranslate.cjs",
    "i18n:audit": "esbuild scripts/i18nAudit.ts --bundle --platform=node --format=cjs --external:typescript --log-level=silent --outfile=out/headless/i18nAudit.cjs && node out/headless/i18nAudit.cjs",
    "migrate:canvas": "esbuild scripts/migrateCanvasToVariants.ts --bundle --platform=node --format=cjs --external:gray-matter --alias:@shared=./src/shared --alias:@engine=./src/engine --log-level=silent --outfile=out/headless/migrateCanvas.cjs && node out/headless/migrateCanvas.cjs",
    "dist": "npm run mcp:build && electron-vite build && electron-builder",
    "dist:dir": "npm run mcp:build && electron-vite build && electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.183",
    "@anthropic-ai/sdk": "^0.105.0",
    "@codemirror/search": "^6.7.1",
    "@headless-tree/core": "^1.7.0",
    "@headless-tree/react": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tiptap/react": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "@xyflow/react": "^12.11.0",
    "adm-zip": "^0.5.18",
    "better-sqlite3": "^11.8.1",
    "chokidar": "^4.0.3",
    "framer-motion": "^12.42.2",
    "gray-matter": "^4.0.3",
    "html-to-image": "^1.11.13",
    "i18next": "^24.2.0",
    "modern-screenshot": "^4.7.0",
    "react-i18next": "^15.4.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.4",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.0.9",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^3.0.0",
    "eslint": "^9.21.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.9",
    "tw-animate-css": "^1.2.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vitest": "^3.0.7"
  }
}
